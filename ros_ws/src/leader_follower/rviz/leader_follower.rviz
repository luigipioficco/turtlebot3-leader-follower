Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 16
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: Follower
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.03
      Color: 255; 90; 40
    - Class: rviz_default_plugins/MarkerArray
      Name: TargetMeasured
      Enabled: true
      Topic:
        Value: /target/markers
    - Class: rviz_default_plugins/Image
      Name: CameraDebug
      Enabled: true
      Topic:
        Value: /target/debug_image
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Odometry
      Name: FollowerOdom
      Enabled: false
      Topic:
        Value: /odom
      Keep: 200
      Shape:
        Value: Arrow
        Alpha: 0.6
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 12
      Pitch: 1.0
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
