<?xml version="1.0"?>
<!-- World for the leader-follower project.

     A 10 x 8 m rectangle enclosed by walls, with a two-blade chicane whose
     gaps alternate. There is no geometric occlusion here: losses of the target
     come from the incidence angle on the marker alone.

     Generated by scripts/generate_world.py, which reads the geometry from
     leader_follower/worlds.py, so the simulated arena and the model used to
     validate the waypoints cannot diverge.

     Ground plane and light are defined locally, because the official worlds
     fetch them from Gazebo Fuel and that requires a connection. -->
<sdf version="1.8">
  <world name="leader_follower">

    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- 2 ms step instead of 1: half the physics steps for the same amount
         of simulated time, and stable with two differential-drive robots -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.75 0.75 0.75 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.3 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.68 0.68 0.68 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <pose>0 4.0 0.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>10.2 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.9 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>10.2 0.1 1.0</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <pose>0 -4.0 0.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>10.2 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.9 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>10.2 0.1 1.0</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <pose>5.0 0 0.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.9 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <pose>-5.0 0 0.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.9 1</ambient>
            <diffuse>0.85 0.85 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="chicane_0">
      <static>true</static>
      <link name="link">
        <pose>-1.6 2.3 0.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.1 3.4 1.0</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.78 1</ambient>
            <diffuse>0.72 0.72 0.78 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.1 3.4 1.0</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="chicane_1">
      <static>true</static>
      <link name="link">
        <pose>1.6 -2.3 0.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.1 3.4 1.0</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.78 1</ambient>
            <diffuse>0.72 0.72 0.78 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.1 3.4 1.0</size></box></geometry>
        </collision>
      </link>
    </model>
    <include>
      <name>aruco_marker_0</name>
      <uri>model://aruco_marker_0</uri>
      <pose>0.0 -3.94 0.4 0 0 0.0</pose>
    </include>
    <include>
      <name>aruco_marker_1</name>
      <uri>model://aruco_marker_1</uri>
      <pose>0.0 3.94 0.4 0 0 0.0</pose>
    </include>
    <include>
      <name>aruco_marker_2</name>
      <uri>model://aruco_marker_2</uri>
      <pose>4.94 0.0 0.4 0 0 1.5708</pose>
    </include>

  </world>
</sdf>
